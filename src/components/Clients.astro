---
import { Image } from "astro:assets";
import client1 from "../assets/client-1.png";
import client2 from "../assets/client-2.png";
import client3 from "../assets/client-3.png";
import client4 from "../assets/client-4.png";
import client5 from "../assets/client-5.png";
import client6 from "../assets/client-6.png";

const clients = [
    { name: "Parceiro 1", logo: client1 },
    { name: "Parceiro 2", logo: client2 },
    { name: "Parceiro 3", logo: client3 },
    { name: "Parceiro 4", logo: client4 },
    { name: "Parceiro 5", logo: client5 },
    { name: "Parceiro 6", logo: client6 },
];
---

<section class="py-20 bg-[var(--bg-dark)] border-t border-[var(--border)]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2
                class="text-2xl md:text-3xl font-bold font-mono text-white mb-4 opacity-90"
            >
                PARCEIROS ESTRATÉGICOS
            </h2>
            <div class="w-24 h-1 bg-[var(--accent)] mx-auto rounded"></div>
        </div>

        <div
            class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 items-center justify-items-center"
        >
            {
                clients.map((client) => (
                    <div class="w-32 h-32 flex items-center justify-center p-4 bg-white/5 border border-[var(--border)] rounded-lg shadow-sm hover:border-[var(--accent)] transition-all duration-300 group">
                        <Image
                            src={client.logo}
                            alt={`Logo ${client.name}`}
                            class="max-w-full max-h-full object-contain md:grayscale md:opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

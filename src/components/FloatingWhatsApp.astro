---
import { MessageCircle } from "lucide-react";
---

<a
    href="https://wa.me/5515999999999?text=Ol%C3%A1%2C%20vim%20pelo%20site%20e%20gostaria%20de%20um%20or%C3%A7amento."
    target="_blank"
    class="fixed bottom-6 right-6 z-50 bg-primary hover:bg-orange-600 text-white p-4 rounded-full shadow-lg shadow-orange-900/40 transition-all transform hover:scale-110 hover:rotate-3 animate-bounce-slow flex items-center justify-center group"
    aria-label="Fale conosco no WhatsApp"
>
    <MessageCircle className="w-8 h-8" />

    <!-- Tooltip -->
    <span
        class="absolute right-full mr-4 bg-secondary text-white text-sm py-2 px-4 rounded whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none shadow-xl"
    >
        Orçamento Rápido
        <span
            class="absolute top-1/2 -right-1 w-2 h-2 bg-secondary transform -translate-y-1/2 rotate-45"
        ></span>
    </span>
</a>

<style>
    @keyframes bounce-slow {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s infinite;
    }
</style>

---
import { MessageCircle } from 'lucide-react';
---

<a href="https://wa.me/5515999999999?text=Olá,%20vi%20o%20site%20da%20Alphawelders%20e%20preciso%20de%20um%20orçamento." 
   target="_blank"
   aria-label="Fale conosco no WhatsApp"
   class="fixed bottom-6 right-6 z-50 bg-green-500 text-white p-4 rounded-full shadow-xl hover:bg-green-600 transition-all hover:scale-110 flex items-center justify-center animate-bounce-slow">
    <MessageCircle size={32} />
</a>
<style>
    .animate-bounce-slow {
        animation: bounce 3s infinite;
    }
    @keyframes bounce {
        0%, 100% {
            transform: translateY(-5%);
            animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
        }
        50% {
            transform: translateY(0);
            animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
        }
    }
</style>

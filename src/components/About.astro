---
import { CheckCircle2, X, Award, MapPin, Calendar } from "lucide-react";
import { Image } from "astro:assets";
import aboutWelder from "../assets/about-welder.png";

const stats = [
    {
        label: "Experiência de Mercado",
        value: "10+ Anos ",
        icon: Calendar,
    },
    { label: "Procedimentos (EPS)", value: "Qualificados", icon: Award },
    { label: "Área de Cobertura", value: "Atendimento Nacional", icon: MapPin },
];
---

<section
    id="sobre"
    class="py-24 bg-[var(--bg-dark)] border-b border-[var(--border)] overflow-hidden relative"
>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Image/Visual Side -->
            <div class="w-full lg:w-1/2 relative group">
                <div
                    class="absolute inset-0 bg-[var(--accent)]/20 transform translate-x-4 translate-y-4 border border-[var(--accent)] z-0 transition-transform group-hover:translate-x-2 group-hover:translate-y-2"
                >
                </div>

                <div
                    class="relative z-10 border border-[var(--border)] bg-[var(--bg-card)] p-2"
                >
                    <Image
                        src={aboutWelder}
                        alt="Soldador profissional Alphawelders"
                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                    />

                    <!-- Tech Overlay -->
                    <div
                        class="absolute bottom-6 right-6 bg-[var(--bg-dark)]/90 backdrop-blur border border-[var(--border)] p-4 max-w-xs"
                    >
                        <p class="text-[var(--accent)] font-mono text-xs mb-1">
                            STATUS: CERTIFICADO
                        </p>
                        <p class="text-[var(--text-secondary)] text-xs">
                            Equipe técnica com registro em carteira e
                            qualificação periódica.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Content Side -->
            <div class="w-full lg:w-1/2">
                <span
                    class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-2 block"
                >
                    Quem Somos
                </span>
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-[var(--text-primary)] mb-8 leading-tight"
                >
                    SEGURANÇA E EXCELÊNCIA <br />
                    <span class="text-[var(--text-secondary)]"
                        >É O QUE NOS MOVE</span
                    >
                </h2>

                <p
                    class="text-lg text-[var(--text-secondary)] mb-10 leading-relaxed border-l-2 border-[var(--border)] pl-4"
                >
                    Especialistas em estruturas críticas e sanitárias. Não
                    vendemos apenas solda, entregamos integridade estrutural
                    para sua planta industrial.
                </p>

                <div class="grid grid-cols-1 gap-4 mb-10">
                    {
                        stats.map((stat) => (
                            <div class="flex items-center gap-4 bg-[var(--bg-card)] border border-[var(--border)] p-4 hover:border-[var(--accent)] transition-colors group">
                                <div class="w-12 h-12 flex items-center justify-center bg-[var(--bg-dark)] rounded border border-[var(--border)] group-hover:text-[var(--accent)] transition-colors">
                                    <stat.icon className="w-6 h-6 text-[var(--text-primary)]" />
                                </div>
                                <div>
                                    <p class="text-[var(--text-secondary)] text-xs font-mono uppercase">
                                        {stat.label}
                                    </p>
                                    <p class="text-[var(--text-primary)] font-bold text-xl font-mono">
                                        {stat.value}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <button
                    id="open-modal-btn"
                    class="inline-flex items-center gap-2 bg-[var(--bg-card)] hover:bg-[var(--accent)] border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text-primary)] hover:text-white font-mono font-bold py-4 px-8 uppercase tracking-wider transition-all"
                >
                    Conheça Nossa História
                </button>
            </div>
        </div>
    </div>
    <dialog
        id="history-modal"
        class="m-auto backdrop:bg-black/90 bg-transparent p-0 w-[95%] max-w-2xl shadow-2xl open:animate-fade-in-up fixed inset-0 z-50 text-[var(--text-primary)]"
    >
        <div
            class="bg-[var(--bg-card)] border border-[var(--border)] relative max-h-[90vh] flex flex-col shadow-2xl shadow-black/50"
        >
            <button
                id="close-modal-btn"
                class="absolute top-4 right-4 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors z-10"
            >
                <X className="w-8 h-8" />
            </button>

            <div class="p-8 md:p-12 overflow-y-auto">
                <div class="flex items-center gap-3 mb-6">
                    <span class="w-2 h-8 bg-[var(--accent)] block"></span>
                    <h3
                        class="text-2xl font-bold font-mono text-[var(--text-primary)] uppercase"
                    >
                        Nossa Jornada
                    </h3>
                </div>

                <div
                    class="space-y-4 text-[var(--text-secondary)] leading-relaxed font-light"
                >
                    <p>
                        Embora jovem, a Alphawelders opera com a expertise de
                        uma equipe com mais de 10 anos de mercado.
                    </p>
                    <p>
                        De Itapetininga para todo o Brasil, elevamos o padrão em
                        solda sanitária e manutenção industrial.
                    </p><p>
                        Vamos onde o projeto exigir, garantindo rigor técnico e
                        performance para que sua operação nunca pare
                    </p>
                </div>
                <p class="font-mono text-[var(--accent)] pt-4">
                    "Liderança que une. Precisão que dura."
                </p>
            </div>
        </div>

        <div
            class="bg-[var(--bg-dark)] px-8 py-4 border-t border-[var(--border)] flex justify-between items-center shrink-0"
        >
            <span class="text-xs text-[var(--border)] font-mono"
                >SYS.LOG: HISTORY_VIEWED</span
            >
            <button
                id="close-modal-footer-btn"
                class="text-[var(--text-primary)] font-bold hover:text-[var(--accent)] transition-colors px-4 py-2 font-mono text-sm uppercase"
            >
                Fechar [ESC]
            </button>
        </div>
    </dialog>
</section>

<script>
    const openBtn = document.getElementById("open-modal-btn");
    const closeBtn = document.getElementById("close-modal-btn");
    const closeFooterBtn = document.getElementById("close-modal-footer-btn");
    const modal = document.getElementById("history-modal") as HTMLDialogElement;

    openBtn?.addEventListener("click", () => {
        modal?.showModal();
    });

    closeBtn?.addEventListener("click", () => {
        modal?.close();
    });

    closeFooterBtn?.addEventListener("click", () => {
        modal?.close();
    });

    // Close when clicking outside
    modal?.addEventListener("click", (e) => {
        const dialogDimensions = modal.getBoundingClientRect();
        if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
        ) {
            modal.close();
        }
    });
</script>

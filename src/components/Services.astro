---
import {
    Flame,
    Wrench,
    Settings,
    Factory,
    Workflow,
    ShieldAlert,
} from "lucide-react";

const services = [
    {
        title: "Solda TIG / GTAW",
        description:
            "Processo de alta pureza para Inox 304/316L e ligas não-ferrosas. Acabamento sanitário grau alimentício.",
        icon: Flame,
    },
    {
        title: "Tubulação Sanitária",
        description:
            "Montagem de linhas de processo (OD) com purga interna e passivação. Certificação para indústrias farmacêuticas.",
        icon: Factory,
    },
    {
        title: "Caldeiraria Industrial",
        description:
            "Fabricação de tanques, skids e suportes estruturais sob medida com solda MIG/MAG e Eletrodo Revestido.",
        icon: Settings,
    },
    {
        title: "Manutenção Especializada",
        description:
            "Intervenções em paradas programadas e reparos emergenciais em trocadores de calor e reatores.",
        icon: Wrench,
    },
];
---

<section
    id="servicos"
    class="py-24 bg-[var(--bg-dark)] border-b border-[var(--border)] relative"
>
    <div
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: radial-gradient(var(--text-secondary) 1px, transparent 1px); background-size: 20px 20px;"
    >
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span
                class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest border border-[var(--accent)] px-2 py-1 mb-4 inline-block"
            >
                Especificações
            </span>
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-bold font-mono text-[var(--text-primary)] mb-6"
            >
                CAPACIDADE TÉCNICA
            </h2>
            <p
                class="text-lg text-[var(--text-secondary)] font-light max-w-2xl mx-auto"
            >
                Soluções de engenharia aplicadas ao chão de fábrica com rigor
                normativo.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                services.map((service, index) => (
                    <div
                        class={`reveal reveal-delay-${(index + 1) * 200} group bg-[var(--bg-card)] p-8 border border-[var(--border)] hover:border-[var(--accent)] transition-all duration-300 transform hover:-translate-y-2 relative overflow-hidden`}
                    >
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <service.icon className="w-24 h-24 text-[var(--text-secondary)]" />
                        </div>

                        <div class="w-12 h-12 bg-[var(--bg-dark)] border border-[var(--border)] rounded flex items-center justify-center mb-6 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-colors duration-300">
                            <service.icon className="w-6 h-6 text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors" />
                        </div>

                        <h3 class="text-xl font-bold font-mono text-[var(--text-primary)] mb-3 group-hover:text-[var(--accent)] transition-colors">
                            {service.title}
                        </h3>

                        <p class="text-[var(--text-secondary)] text-sm leading-relaxed mb-4">
                            {service.description}
                        </p>

                        <div class="w-full h-[1px] bg-[var(--border)] group-hover:bg-[var(--accent)]/50 transition-colors mt-auto" />
                        <div class="pt-4 flex justify-between items-center text-xs font-mono text-[var(--text-secondary)] group-hover:text-[var(--text-primary)]">
                            <span>SPEC-0{services.indexOf(service) + 1}</span>
                            <span class="opacity-0 group-hover:opacity-100 transition-opacity">
                                →
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

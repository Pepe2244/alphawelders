---
import {
    Facebook,
    Instagram,
    Linkedin,
    Mail,
    MapPin,
    Phone,
    MoveRight,
} from "lucide-react";
---

<footer
    class="bg-[#050505] text-[var(--text-secondary)] pt-20 pb-10 border-t border-[var(--border)]"
    id="contato"
>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <!-- CTA Massive Contact Area -->
        <div
            class="mb-20 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center border-b border-[var(--border)] pb-16"
        >
            <div>
                <span
                    class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-4 block"
                >
                    Está pronto para começar?
                </span>
                <h2
                    class="text-4xl md:text-5xl lg:text-6xl font-bold font-mono text-white mb-6"
                >
                    FALE AGORA COM <br />
                    <span class="text-[var(--accent)]">NOSSA ENGENHARIA.</span>
                </h2>
                <p class="text-lg max-w-xl font-light">
                    Soluções técnicas não podem esperar. Atendimento imediato
                    via WhatsApp ou Telefone.
                </p>
            </div>

            <div class="flex flex-col gap-4">
                <a
                    href="https://wa.me/5515998608170"
                    target="_blank"
                    class="group flex items-center justify-between bg-[var(--bg-card)] border border-[var(--border)] hover:border-[var(--accent)] p-6 transition-all duration-300"
                >
                    <div class="flex items-center gap-6">
                        <div
                            class="w-12 h-12 bg-[var(--bg-dark)] rounded flex items-center justify-center text-[var(--text-secondary)] group-hover:bg-[var(--accent)]/10 group-hover:text-[var(--accent)] transition-all"
                        >
                            <Phone className="w-6 h-6" />
                        </div>
                        <div>
                            <p
                                class="text-xs font-mono uppercase tracking-widest mb-1"
                            >
                                Plantão Técnico 24h
                            </p>
                            <p
                                class="text-lg md:text-xl font-mono font-bold text-white group-hover:text-[var(--accent)] transition-colors"
                            >
                                (15) 99860-8170
                            </p>
                        </div>
                    </div>
                    <MoveRight
                        className="w-6 h-6 text-[var(--border)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all"
                    />
                </a>

                <a
                    href="mailto:alphawelders1@gmail.com"
                    class="group flex items-center justify-between bg-[var(--bg-card)] border border-[var(--border)] hover:border-[var(--accent)] p-6 transition-all duration-300"
                >
                    <div class="flex items-center gap-6">
                        <div
                            class="w-12 h-12 bg-[var(--bg-dark)] rounded flex items-center justify-center text-[var(--text-secondary)] group-hover:bg-[var(--accent)]/10 group-hover:text-[var(--accent)] transition-all"
                        >
                            <Mail className="w-6 h-6" />
                        </div>
                        <div>
                            <p
                                class="text-xs font-mono uppercase tracking-widest mb-1"
                            >
                                Envie seu Projeto
                            </p>
                            <p
                                class="text-sm sm:text-lg md:text-xl font-mono font-bold text-white group-hover:text-[var(--accent)] transition-colors break-all"
                            >
                                alphawelders1@gmail.com
                            </p>
                        </div>
                    </div>
                    <MoveRight
                        className="w-6 h-6 text-[var(--border)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all"
                    />
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
            <!-- Brand -->
            <div class="col-span-1 md:col-span-2 space-y-6">
                <div
                    class="text-2xl font-bold font-mono tracking-tighter uppercase text-white"
                >
                    Alpha<span class="text-[var(--accent)]">welders</span>
                </div>
                <p
                    class="text-[var(--text-secondary)] leading-relaxed max-w-sm font-light text-sm"
                >
                    Referência absoluta em soldagem industrial de alta precisão.
                    Comprometimento com normas técnicas, prazos e a segurança da
                    sua operação.
                </p>
                <div class="flex space-x-4">
                    <a
                        href="#"
                        aria-label="Facebook"
                        class="w-10 h-10 border border-[var(--border)] flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--accent)] hover:border-[var(--accent)] transition-all"
                    >
                        <Facebook className="w-5 h-5" />
                    </a>
                    <a
                        href="#"
                        aria-label="Instagram"
                        class="w-10 h-10 border border-[var(--border)] flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--accent)] hover:border-[var(--accent)] transition-all"
                    >
                        <Instagram className="w-5 h-5" />
                    </a>
                    <a
                        href="#"
                        aria-label="LinkedIn"
                        class="w-10 h-10 border border-[var(--border)] flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--accent)] hover:border-[var(--accent)] transition-all"
                    >
                        <Linkedin className="w-5 h-5" />
                    </a>
                </div>
            </div>

            <!-- Links -->
            <div>
                <h3
                    class="text-white font-bold font-mono text-sm uppercase tracking-widest mb-6"
                >
                    Navegação
                </h3>
                <ul class="space-y-4 font-mono text-sm">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[var(--accent)] transition-colors block py-1 border-b border-transparent hover:border-[var(--accent)] w-fit"
                            >Início</a
                        >
                    </li>
                    <li>
                        <a
                            href="#servicos"
                            class="hover:text-[var(--accent)] transition-colors block py-1 border-b border-transparent hover:border-[var(--accent)] w-fit"
                            >Capacidade Técnica</a
                        >
                    </li>
                    <li>
                        <a
                            href="#galeria"
                            class="hover:text-[var(--accent)] transition-colors block py-1 border-b border-transparent hover:border-[var(--accent)] w-fit"
                            >Acervo Técnico</a
                        >
                    </li>
                    <li>
                        <a
                            href="#contato"
                            class="hover:text-[var(--accent)] transition-colors block py-1 border-b border-transparent hover:border-[var(--accent)] w-fit"
                            >Contato</a
                        >
                    </li>
                    <li>
                        <a
                            href="/ParceriaNalessoGTAW.pdf"
                            target="_blank"
                            class="hover:text-[var(--accent)] transition-colors block py-1 border-b border-transparent hover:border-[var(--accent)] w-fit"
                            >Portfólio PDF</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Address -->
            <div>
                <h3
                    class="text-white font-bold font-mono text-sm uppercase tracking-widest mb-6"
                >
                    Operação
                </h3>
                <ul
                    class="space-y-4 font-mono text-sm text-[var(--text-secondary)]"
                >
                    <li class="flex items-start gap-3">
                        <MapPin
                            className="w-5 h-5 text-[var(--accent)] mt-1 flex-shrink-0"
                        />
                        <span>
                            Itapetininga - SP<br />
                            Atendimento Nacional
                        </span>
                    </li>
                    <li class="pt-4 border-t border-[var(--border)]">
                        <span class="block text-[var(--accent)] text-xs mb-1"
                            >HORÁRIO TÉCNICO</span
                        >
                        Seg - Sex: 08:00 - 18:00
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="border-t border-[var(--border)] pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-[var(--text-secondary)]"
        >
            <p>
                &copy; {new Date().getFullYear()} Alphawelders &mdash; Precisão Industrial.
            </p>
            <p>SYSTEM: ONLINE // VERSION: 2.5.0</p>
        </div>
    </div>
</footer>

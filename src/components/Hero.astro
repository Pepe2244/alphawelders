---
import { ArrowRight } from "lucide-react";
---

<section class="relative bg-secondary overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 z-0">
        <img
            src="/hero-bg.png"
            alt="Industrial Welding Background"
            class="w-full h-full object-cover opacity-20"
        />
        <div
            class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/10 to-transparent"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2"
        >
        </div>
    </div>

    <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 relative z-10"
    >
        <div class="max-w-3xl">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-primary mb-6 animate-fade-in-up"
            >
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"
                ></span>
                <span class="text-sm font-semibold tracking-wide uppercase"
                    >Atendimento em Itapetininga e Região</span
                >
            </div>

            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold font-heading text-white leading-tight mb-6 drop-shadow-lg"
            >
                Liderança que une. <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-400"
                    >Precisão que dura.</span
                >
            </h1>

            <p
                class="text-lg md:text-xl text-tertiary mb-10 max-w-2xl leading-relaxed"
            >
                Segurança e excelência é o que nos move. <br
                    class="hidden md:block"
                />
                Desde 2010 oferecendo soluções completas em GTAW (TIG), SMAW e Caldeiraria
                Industrial.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
                <a
                    href="https://wa.me/5515999999999"
                    target="_blank"
                    class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-orange-600 text-white text-lg font-bold px-8 py-4 rounded shadow-lg shadow-orange-900/30 transition-all transform hover:-translate-y-1"
                >
                    Solicitar Cotação Agora
                    <ArrowRight className="w-5 h-5" />
                </a>

                <a
                    href="#servicos"
                    class="inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/20 text-white text-lg font-semibold px-8 py-4 rounded transition-all backdrop-blur-sm"
                >
                    Conhecer Soluções
                </a>
            </div>
        </div>
    </div>
</section>

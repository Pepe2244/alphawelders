---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Solda TIG Especializada e Manutenção Industrial em Itapetininga. Precisão e qualidade para sua indústria.",
} = Astro.props;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://alphawelders.netlify.app/",
);
const socialImageURL = new URL(
    "/social-image.jpg",
    Astro.site || "https://alphawelders.netlify.app/",
); // Placeholder
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <title>{title}</title>

        <!-- Schema.org JSON-LD -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                name: "Alphawelders",
                image: new URL(
                    "/logo.png",
                    Astro.site || "https://alphawelders.netlify.app/",
                ).toString(),
                "@id": (
                    Astro.site || "https://alphawelders.netlify.app/"
                ).toString(),
                url: (
                    Astro.site || "https://alphawelders.netlify.app/"
                ).toString(),
                telephone: "+5515999999999",
                address: {
                    "@type": "PostalAddress",
                    streetAddress: "Itapetininga e Região",
                    addressLocality: "Itapetininga",
                    addressRegion: "SP",
                    postalCode: "18200-000",
                    addressCountry: "BR",
                },
                priceRange: "$$",
                openingHoursSpecification: {
                    "@type": "OpeningHoursSpecification",
                    dayOfWeek: [
                        "Monday",
                        "Tuesday",
                        "Wednesday",
                        "Thursday",
                        "Friday",
                    ],
                    opens: "08:00",
                    closes: "18:00",
                },
            })}
        />
    </head>
    <body
        class="bg-[var(--bg-dark)] text-[var(--text-primary)] font-sans antialiased selection:bg-[var(--accent)] selection:text-white"
    >
        <slot />

        <script>
            function initAnimations() {
                const observerOptions = {
                    root: null,
                    rootMargin: "0px",
                    threshold: 0.1,
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("active");
                            observer.unobserve(entry.target); // Only animate once
                        }
                    });
                }, observerOptions);

                const revealElements = document.querySelectorAll(".reveal");
                revealElements.forEach((el) => observer.observe(el));
            }

            // Init on load
            document.addEventListener("DOMContentLoaded", initAnimations);

            // Re-init if using View Transitions (just in case future proofing)
            document.addEventListener("astro:page-load", initAnimations);
        </script>
    </body>
</html>

<style is:global>
    :root {
        --bg-dark: #0f1115;
        --bg-card: #161b22;
        --text-primary: #f0f6fc;
        --text-secondary: #8b949e;
        --accent: #ff5c00;
        --border: #30363d;

        --font-sans: "Inter", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", monospace;
    }

    body {
        background-color: var(--bg-dark);
        color: var(--text-primary);
        font-family: var(--font-sans);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: var(--font-mono);
        letter-spacing: -0.02em;
    }
</style>
